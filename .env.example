# Ghost Project AI — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores reais

# Meshy.ai / Tripo3D — geração de modelos 3D. SEM prefixo VITE_ de propósito:
# variáveis VITE_* são gravadas em texto puro no JS enviado ao navegador: uma
# chave paga exposta assim pode ser roubada e usada à sua custa (ver
# incidente de segurança 2026-07-09). Essas chaves só devem ser lidas por
# scripts Node (CLI/servidor), nunca por código importado no app do navegador.
# Meshy.ai (https://app.meshy.ai → API Keys)
MESHY_API_KEY=
# Tripo3D (https://platform.tripo3d.ai → API Keys)
TRIPO_API_KEY=

# DeepAR — AR Try-On SDK (https://developer.deepar.ai → sua Web App → Web License Key)
# Domínios a cadastrar: localhost (dev) | ghost-project-ai.vercel.app (prod)
# Usado em: ?lab=deepar (DeepARLab.jsx) — M068A
VITE_DEEPAR_LICENSE_KEY=cole_sua_chave_deepar_aqui
