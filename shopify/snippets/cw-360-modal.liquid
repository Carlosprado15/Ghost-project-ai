{%- comment %} Click & Wear — 360° Preview Modal (M051) {%- endcomment -%}
<div
  id="cw-360-modal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="Visualização 360° do produto"
  style="display:none"
>
  <div id="cw-360-backdrop"></div>
  <div id="cw-360-panel">
    <div id="cw-360-header">
      <button id="cw-360-close" type="button" aria-label="Fechar">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div id="cw-360-info">
      <p id="cw-360-product-name"></p>
      <p id="cw-360-subtitle">Gire o produto em 360°</p>
    </div>
    <div id="cw-360-viewer-wrap">
      <div id="cw-360-loading" class="cw-360-hidden" aria-hidden="true">
        <div class="cw-360-spinner"></div>
        <p class="cw-360-loading-text">Carregando modelo...</p>
      </div>
      <div id="cw-360-viewer-mount"></div>
    </div>
    <div id="cw-360-footer">
      <p id="cw-360-hint-text">Arraste para girar &nbsp;·&nbsp; Pinça para zoom</p>
    </div>
  </div>
</div>
<script src="{{ 'ghost-360-modal.js' | asset_url }}?v=055" defer></script>
